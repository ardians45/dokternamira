---
interface Props {
  variant?: 'primary' | 'secondary' | 'accent';
  class?: string;
}

const { variant = 'primary', class: className = '' } = Astro.props;

const variants = {
  primary: 'bg-teal-100 text-teal-deep border-teal-200',
  secondary: 'bg-slate-100 text-slate-600 border-slate-200',
  accent: 'bg-pink-100 text-pink-600 border-pink-200'
};
---
<span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase border ${variants[variant]} ${className}`}>
  <slot />
</span>
