---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/React/WhatsAppFloat';
import { MapPin, Clock, Phone, Navigation } from 'lucide-react';
---

<BaseLayout
  title="Jadwal Praktik & Lokasi Dokter Namira Malang"
  description="Alamat lengkap Ruko Ragali Residence Tirto Joyo Merjosari Malang, jam praktik pagi & sore, serta perawatan kecantikan, dan peta lokasi petunjuk arah."
>
  <Header />

  <main class="flex-grow bg-slate-50">
    <!-- Premium Hero Section -->
    <section class="relative bg-slate-950 text-white pt-20 pb-24 overflow-hidden border-b border-teal-900/50">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-teal-800/40 via-transparent to-transparent"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-600/20 rounded-full blur-[100px]"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center scroll-animate">
        <div class="inline-flex items-center space-x-2 bg-white/10 border border-white/20 backdrop-blur-md px-4 py-2 rounded-full text-teal-300 text-xs font-bold uppercase tracking-widest mb-6 shadow-glass">
          <MapPin size={14} />
          <span>Lokasi & Waktu Pelayanan</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold tracking-tight leading-[1.15] mb-6">
          Jadwal Praktik & <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-300">Lokasi Klinik</span>
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-sans">
          Kunjungi tempat praktik kami di Malang atau buat janji temu sesuai dengan jadwal operasional yang tersedia di bawah ini.
        </p>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="py-16 md:py-24 relative -mt-8 z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="bg-white p-6 md:p-10 rounded-3xl border border-slate-200 shadow-premium scroll-animate">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
            
            <!-- Left Info Panel -->
            <div class="lg:col-span-5 space-y-8">
              <div class="space-y-2">
                <h2 class="text-3xl font-display font-bold text-slate-900">Informasi Praktik</h2>
                <p class="text-sm text-slate-500 leading-relaxed">Berikut adalah rincian jam operasional dan kontak yang dapat Anda hubungi.</p>
              </div>
              
              <!-- Elegant Schedule Cards -->
              <div class="space-y-4">
                
                <div class="group relative bg-slate-50 p-5 rounded-2xl border border-slate-100 hover:border-teal-300 hover:shadow-md transition-all duration-300 overflow-hidden">
                  <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-teal-500 rounded-l-2xl group-hover:w-2 transition-all"></div>
                  <div class="flex items-start space-x-4 ml-2">
                    <div class="w-10 h-10 rounded-xl bg-white text-teal-600 flex items-center justify-center shadow-sm shrink-0">
                      <Clock size={20} />
                    </div>
                    <div>
                      <strong class="block text-slate-800 font-bold mb-1 text-sm group-hover:text-teal-700 transition-colors">Praktek Umum & Konsultasi</strong>
                      <div class="flex flex-col space-y-1">
                        <span class="inline-flex items-center text-xs font-semibold text-slate-600 bg-white px-2.5 py-1 rounded-md shadow-sm border border-slate-100 w-fit">Pagi: <span class="text-teal-600 ml-1">06.00 - 09.00 WIB</span></span>
                        <span class="inline-flex items-center text-xs font-semibold text-slate-600 bg-white px-2.5 py-1 rounded-md shadow-sm border border-slate-100 w-fit">Sore: <span class="text-teal-600 ml-1">16.00 - 20.00 WIB</span></span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="group relative bg-slate-50 p-5 rounded-2xl border border-slate-100 hover:border-pink-300 hover:shadow-md transition-all duration-300 overflow-hidden">
                  <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-pink-500 rounded-l-2xl group-hover:w-2 transition-all"></div>
                  <div class="flex items-start space-x-4 ml-2">
                    <div class="w-10 h-10 rounded-xl bg-white text-pink-500 flex items-center justify-center shadow-sm shrink-0">
                      <Clock size={20} />
                    </div>
                    <div>
                      <strong class="block text-slate-800 font-bold mb-1 text-sm group-hover:text-pink-600 transition-colors">Syar'i Beauty Care</strong>
                      <span class="inline-flex items-center text-xs font-semibold text-slate-600 bg-white px-2.5 py-1 rounded-md shadow-sm border border-slate-100 w-fit">Siang: <span class="text-pink-500 ml-1">09.00 - 16.00 WIB</span></span>
                    </div>
                  </div>
                </div>

                <!-- Contact & Address -->
                <div class="pt-4 border-t border-slate-100 space-y-4">
                  <div class="flex items-start space-x-3">
                    <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center shrink-0">
                      <MapPin size={16} />
                    </div>
                    <div>
                      <strong class="block text-slate-800 font-bold mb-0.5 text-sm">Alamat Klinik</strong>
                      <p class="text-xs text-slate-600 leading-relaxed">Ruko Perumahan Ragali Residence, Jl. Tirto Joyo No. 119-69, Merjosari, Lowokwaru, Malang 65144</p>
                    </div>
                  </div>
                  <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center shrink-0">
                      <Phone size={16} />
                    </div>
                    <div>
                      <strong class="block text-slate-800 font-bold mb-0.5 text-sm">Telepon / WhatsApp</strong>
                      <p class="text-xs text-slate-600">0858-1980-0843 / 0852-7000-1948</p>
                    </div>
                  </div>
                </div>

              </div>

              <div class="pt-2">
                <a
                  href="https://maps.app.goo.gl/3MeZCrY49Nifmsp87"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-4 rounded-2xl shadow-premium hover:-translate-y-1 transition-all duration-300 w-full text-sm"
                >
                  <Navigation size={18} />
                  <span>Buka Navigasi Google Maps</span>
                </a>
              </div>
            </div>

            <!-- Right Map Panel -->
            <div class="lg:col-span-7 h-full min-h-[400px]">
              <div class="w-full h-full min-h-[400px] rounded-[2rem] overflow-hidden border-4 border-slate-50 shadow-premium relative group bg-slate-100">
                <div class="absolute inset-0 border border-slate-200/50 rounded-[2rem] pointer-events-none z-10"></div>
                <iframe
                  title="Peta Lokasi Dokter Namira Malang"
                  src="https://www.google.com/maps?q=Praktek+dr.+Namira+Farhayati+Lubis,+Malang&output=embed"
                  class="w-full h-full absolute inset-0 transition-transform duration-700 group-hover:scale-[1.02]"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat client:idle />
</BaseLayout>
