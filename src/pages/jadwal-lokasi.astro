---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/React/WhatsAppFloat';
import { MapPin, Clock, Phone, Navigation } from 'lucide-react';
---

<BaseLayout
  title="Jadwal Praktik & Lokasi Dokter Namira Malang"
  description="Alamat lengkap Ruko Ragali Residence Tirto Joyo Merjosari Malang, jam praktik pagi & sore, serta perawatan kecantikan, dan peta lokasi petunjuk arah."
>
  <Header />

  <main class="flex-grow">
    <section class="bg-gradient-to-br from-teal-deep via-[#014758] to-slate-dark text-white py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center space-x-2 bg-teal-soft/20 border border-teal-soft/40 px-3.5 py-1.5 rounded-full text-teal-light text-xs font-semibold">
            <MapPin size={14} class="text-emerald-400" />
            <span>Merjosari, Lowokwaru, Kota Malang</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
            Jadwal Praktik & Panduan Lokasi
          </h1>
          <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
            Temukan alamat lengkap tempat praktik kami di Ruko Ragali Residence dan cek jam operasional pelayanan dokter.
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-5 space-y-6">
            <div class="bg-slate-50 p-6 rounded-3xl border border-slate-200 space-y-4">
              <h2 class="text-xl font-bold text-teal-deep">Informasi Tempat Praktik</h2>
              
              <div class="space-y-3 text-xs text-slate-700">
                <div class="flex items-start space-x-3">
                  <MapPin size={18} class="text-teal-soft shrink-0 mt-0.5" />
                  <div>
                    <strong class="block text-slate-800 font-bold mb-0.5">Alamat Ruko:</strong>
                    <span>Ruko Perumahan Ragali Residence, Jl. Tirto Joyo No. 119-69, Merjosari, Lowokwaru, Malang 65144</span>
                  </div>
                </div>

                <div class="flex items-start space-x-3">
                  <Clock size={18} class="text-teal-soft shrink-0 mt-0.5" />
                  <div>
                    <strong class="block text-slate-800 font-bold mb-0.5">Jam Praktik:</strong>
                    <span class="space-y-1 block mt-1">
                      <span class="block"><strong>Praktek Umum:</strong> <span class="text-teal-deep">06.00-09.00</span> & <span class="text-teal-deep">16.00-20.00</span></span>
                      <span class="block"><strong>Kecantikan:</strong> <span class="text-teal-deep">09.00-16.00</span></span>
                    </span>
                  </div>
                </div>

                <div class="flex items-start space-x-3">
                  <Phone size={18} class="text-teal-soft shrink-0 mt-0.5" />
                  <div>
                    <strong class="block text-slate-800 font-bold mb-0.5">Nomor Telepon / WA:</strong>
                    <span>0858-1980-0843 / 0852-7000-1948</span>
                  </div>
                </div>
              </div>

              <div class="pt-2">
            <a
              href="https://maps.app.goo.gl/4Jq9rNgjSmcEqxQR6"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full"
            >
              <Navigation size={16} />
              <span>Buka Navigasi Google Maps</span>
            </a>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <div class="w-full h-96 rounded-3xl overflow-hidden border border-slate-200 shadow-xl">
              <iframe
                title="Peta Lokasi Praktek Dokter Namira"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3951.4988775438844!2d112.6024194!3d-7.9400015!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e78826a7e028889%3A0x6b40285a85012345!2sJl.%20Tirto%20Joyo%2C%20Merjosari%2C%20Kec.%20Lowokwaru%2C%20Kota%20Malang%2C%20Jawa%20Timur!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat client:idle />
</BaseLayout>
