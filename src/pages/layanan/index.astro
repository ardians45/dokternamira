---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/React/WhatsAppFloat.jsx';
import { Stethoscope, Home, ShieldCheck, Droplet, HeartPulse, Sparkles, ChevronRight, Scissors, ShoppingBag } from 'lucide-react';
---

<BaseLayout
  title="Daftar Layanan Medis Complete - Praktek Dokter Namira Malang"
  description="Indeks lengkap seluruh layanan kesehatan Praktek Dokter Namira Malang: Dokter Umum, Homecare, Konsultasi IMS Privat, Infus Booster, Bekam Medis, dan Syar'i Beauty Care."
>
  <Header />

  <main class="flex-grow bg-slate-50">
    <!-- Premium Hero Section -->
    <section class="relative bg-slate-950 text-white pt-20 pb-24 overflow-hidden border-b border-teal-900/50">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-teal-800/40 via-transparent to-transparent"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-600/20 rounded-full blur-[100px]"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center scroll-animate">
        <div class="inline-flex items-center space-x-2 bg-white/10 border border-white/20 backdrop-blur-md px-4 py-2 rounded-full text-teal-300 text-xs font-bold uppercase tracking-widest mb-6 shadow-glass">
          <Stethoscope size={14} />
          <span>Indeks Layanan Medis</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold tracking-tight leading-[1.15] mb-6">
          Layanan Medis <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-300">Dokter Namira</span>
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-sans">
          Temukan solusi penanganan medis komprehensif yang dirancang secara personal dan profesional sesuai kebutuhan Anda di Malang.
        </p>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="py-16 md:py-24 relative -mt-8 z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          
          <a href="/layanan/homecare-malang" class="group relative bg-white p-6 md:p-8 rounded-3xl border border-slate-200 hover:border-teal-300 hover:shadow-premium transition-all duration-300 overflow-hidden flex flex-col scroll-animate">
            <div class="absolute right-0 top-0 w-32 h-32 bg-gradient-to-br from-teal-50 to-teal-100/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-125"></div>
            <div class="w-14 h-14 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center mb-6 group-hover:bg-teal-600 group-hover:text-white transition-colors duration-300 shadow-sm">
              <Home size={28} />
            </div>
            <h3 class="font-display font-bold text-xl text-slate-900 group-hover:text-teal-deep transition-colors mb-3">Dokter Homecare</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">Kunjungan dokter dan perawatan medis langsung di rumah Anda dengan peralatan standar medis.</p>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-sm font-bold text-teal-600 group-hover:text-teal-700 transition-colors">
              <span>Pelajari Detail</span>
              <div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center group-hover:bg-teal-100 transition-colors">
                <ChevronRight size={16} />
              </div>
            </div>
          </a>

          <a href="/layanan/infeksi-menular-seksual" class="group relative bg-white p-6 md:p-8 rounded-3xl border border-slate-200 hover:border-amber-300 hover:shadow-premium transition-all duration-300 overflow-hidden flex flex-col scroll-animate" style="transition-delay: 50ms;">
            <div class="absolute right-0 top-0 w-32 h-32 bg-gradient-to-br from-amber-50 to-amber-100/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-125"></div>
            <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-6 group-hover:bg-amber-500 group-hover:text-white transition-colors duration-300 shadow-sm">
              <ShieldCheck size={28} />
            </div>
            <h3 class="font-display font-bold text-xl text-slate-900 group-hover:text-amber-700 transition-colors mb-3">Konsultasi IMS</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">Penanganan medis gejala penyakit menular seksual secara 100% privat, rahasia, dan tanpa stigma.</p>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-sm font-bold text-amber-600 group-hover:text-amber-700 transition-colors">
              <span>Pelajari Detail</span>
              <div class="w-8 h-8 rounded-full bg-amber-50 flex items-center justify-center group-hover:bg-amber-100 transition-colors">
                <ChevronRight size={16} />
              </div>
            </div>
          </a>

          <a href="/layanan/infus-booster-vitamin" class="group relative bg-white p-6 md:p-8 rounded-3xl border border-slate-200 hover:border-blue-300 hover:shadow-premium transition-all duration-300 overflow-hidden flex flex-col scroll-animate" style="transition-delay: 100ms;">
            <div class="absolute right-0 top-0 w-32 h-32 bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-125"></div>
            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shadow-sm">
              <Droplet size={28} />
            </div>
            <h3 class="font-display font-bold text-xl text-slate-900 group-hover:text-blue-700 transition-colors mb-3">Infus Booster & Vitamin</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">Terapi cairan infus multivitamin untuk kebugaran, pemulihan stamina pasca sakit, dan pencerah kulit.</p>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-sm font-bold text-blue-600 group-hover:text-blue-700 transition-colors">
              <span>Pelajari Detail</span>
              <div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center group-hover:bg-blue-100 transition-colors">
                <ChevronRight size={16} />
              </div>
            </div>
          </a>

          <a href="/layanan/bekam-sunnah-fashdu" class="group relative bg-white p-6 md:p-8 rounded-3xl border border-slate-200 hover:border-red-300 hover:shadow-premium transition-all duration-300 overflow-hidden flex flex-col scroll-animate">
            <div class="absolute right-0 top-0 w-32 h-32 bg-gradient-to-br from-red-50 to-red-100/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-125"></div>
            <div class="w-14 h-14 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center mb-6 group-hover:bg-red-600 group-hover:text-white transition-colors duration-300 shadow-sm">
              <HeartPulse size={28} />
            </div>
            <h3 class="font-display font-bold text-xl text-slate-900 group-hover:text-red-700 transition-colors mb-3">Bekam & Fashdu Medis</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">Terapi bekam medis higienis dipadukan dengan teknik fashdu untuk mengeluarkan toksin darah.</p>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-sm font-bold text-red-600 group-hover:text-red-700 transition-colors">
              <span>Pelajari Detail</span>
              <div class="w-8 h-8 rounded-full bg-red-50 flex items-center justify-center group-hover:bg-red-100 transition-colors">
                <ChevronRight size={16} />
              </div>
            </div>
          </a>

          <a href="/layanan/khitan-sunat" class="group relative bg-white p-6 md:p-8 rounded-3xl border border-slate-200 hover:border-amber-300 hover:shadow-premium transition-all duration-300 overflow-hidden flex flex-col scroll-animate">
            <div class="absolute right-0 top-0 w-32 h-32 bg-gradient-to-br from-amber-50 to-amber-100/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-125"></div>
            <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-6 group-hover:bg-amber-600 group-hover:text-white transition-colors duration-300 shadow-sm">
              <Scissors size={28} />
            </div>
            <h3 class="font-display font-bold text-xl text-slate-900 group-hover:text-amber-700 transition-colors mb-3">Sunat / Khitan Modern</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">Layanan sunat anak & dewasa steril medis, minim rasa sakit, dengan opsi tindakan di klinik atau Homecare visit.</p>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-sm font-bold text-amber-600 group-hover:text-amber-700 transition-colors">
              <span>Pelajari Detail</span>
              <div class="w-8 h-8 rounded-full bg-amber-50 flex items-center justify-center group-hover:bg-amber-100 transition-colors">
                <ChevronRight size={16} />
              </div>
            </div>
          </a>

          <a href="/layanan/syari-beauty-care" class="group relative bg-white p-6 md:p-8 rounded-3xl border border-slate-200 hover:border-pink-300 hover:shadow-premium transition-all duration-300 overflow-hidden flex flex-col scroll-animate" style="transition-delay: 50ms;">
            <div class="absolute right-0 top-0 w-32 h-32 bg-gradient-to-br from-pink-50 to-pink-100/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-125"></div>
            <div class="w-14 h-14 rounded-2xl bg-pink-50 text-pink-600 flex items-center justify-center mb-6 group-hover:bg-pink-600 group-hover:text-white transition-colors duration-300 shadow-sm">
              <Sparkles size={28} />
            </div>
            <h3 class="font-display font-bold text-xl text-slate-900 group-hover:text-pink-600 transition-colors mb-3">Syar'i Beauty & Aesthetic Care</h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">Pusat perawatan kesehatan dan estetika kulit wajah khusus wanita (Facial, Peeling & Serum Namglow) dengan privasi tertutup.</p>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-sm font-bold text-pink-600 group-hover:text-pink-700 transition-colors">
              <span>Pelajari Detail</span>
              <div class="w-8 h-8 rounded-full bg-pink-50 flex items-center justify-center group-hover:bg-pink-100 transition-colors">
                <ChevronRight size={16} />
              </div>
            </div>
          </a>

          <a href="/produk" class="group relative bg-gradient-to-br from-amber-50 via-white to-amber-100/40 p-6 md:p-8 rounded-3xl border border-amber-200 hover:border-amber-400 hover:shadow-premium transition-all duration-300 overflow-hidden flex flex-col md:col-span-2 lg:col-span-3 scroll-animate" style="transition-delay: 100ms;">
            <div class="flex items-center justify-between mb-4">
              <div class="w-14 h-14 rounded-2xl bg-amber-500 text-white flex items-center justify-center shadow-md">
                <ShoppingBag size={28} />
              </div>
              <span class="bg-amber-500 text-white font-bold text-xs px-3 py-1 rounded-full uppercase">Katalog Produk Resmi</span>
            </div>
            <h3 class="font-display font-extrabold text-2xl text-slate-900 group-hover:text-amber-700 transition-colors mb-2">Produk Sehat & Skincare Dokter Namira</h3>
            <p class="text-sm text-slate-600 leading-relaxed max-w-2xl flex-grow">Raw Honey Akasia Sumatra murni 100%, Promo Madu Multiflora Grosir, Serum Brightening BPOM, hingga Cream Racikan Gatal resep dokter.</p>
            <div class="mt-6 pt-4 border-t border-amber-200/60 flex items-center justify-between text-sm font-bold text-amber-700">
              <span>Lihat Katalog Produk Lengkap</span>
              <div class="w-8 h-8 rounded-full bg-amber-200/80 flex items-center justify-center">
                <ChevronRight size={16} />
              </div>
            </div>
          </a>

        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat client:idle />
</BaseLayout>
