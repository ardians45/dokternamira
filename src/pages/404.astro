---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Home } from 'lucide-react';
---

<BaseLayout
  title="404 Halaman Tidak Ditemukan - Praktek Dokter Namira"
  description="Halaman yang Anda cari tidak ditemukan atau telah dipindahkan."
>
  <Header />

  <main class="flex-grow flex items-center justify-center py-20 bg-slate-50">
    <div class="max-w-md mx-auto text-center px-4 space-y-6">
      <div class="w-20 h-20 mx-auto rounded-3xl bg-teal-light text-teal-deep flex items-center justify-center font-extrabold text-3xl shadow-sm">
        404
      </div>
      <h1 class="text-2xl font-extrabold text-teal-deep">Halaman Tidak Ditemukan</h1>
      <p class="text-xs text-slate-600 leading-relaxed">
        Maaf, halaman yang Anda tuju tidak ditemukan atau URL yang Anda masukkan salah.
      </p>
      <div>
        <a href="/" class="btn-primary inline-flex items-center space-x-2">
          <Home size={24} />
          <span>Kembali ke Beranda</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
