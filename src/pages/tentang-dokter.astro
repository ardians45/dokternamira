---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/React/WhatsAppFloat';
import { Stethoscope, ShieldCheck, Award, Heart, CheckCircle2, PhoneCall } from 'lucide-react';
---

<BaseLayout
  title="Profil Dokter Namira (Dr. Namira Farhayati Lubis) | Dokter Umum Malang"
  description="Profil lengkap Dokter Namira (Dr. Namira Farhayati Lubis). Dokter umum penanggung jawab Praktek Dokter Namira di Malang. Info jadwal dan layanan homecare."
>
  <Header />

  <main class="flex-grow bg-slate-50">
    <!-- Premium Hero Section -->
    <section class="relative bg-slate-950 text-white pt-20 pb-24 overflow-hidden border-b border-teal-900/50">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-teal-800/40 via-transparent to-transparent"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-600/20 rounded-full blur-[100px]"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center scroll-animate">
        <div class="inline-flex items-center space-x-2 bg-white/10 border border-white/20 backdrop-blur-md px-4 py-2 rounded-full text-teal-300 text-xs font-bold uppercase tracking-widest mb-6 shadow-glass">
          <Stethoscope size={14} />
          <span>Profil Dokter Namira</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold tracking-tight leading-[1.15] mb-6">
          Dr. Namira <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-300">Farhayati Lubis</span>
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-sans">
          Dokter Umum penanggung jawab praktek medis, pelayanan kunjungan homecare terpadu, serta konsultan kesehatan masyarakat di Malang.
        </p>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="py-16 md:py-24 relative -mt-8 z-10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        
        <div class="bg-white p-8 md:p-10 rounded-3xl border border-slate-200 shadow-premium scroll-animate">
          
          <div class="text-center space-y-4 mb-10 border-b border-slate-100 pb-8">
            <h2 class="text-2xl md:text-3xl font-display font-bold text-slate-900">Dedikasi untuk Kesehatan Anda</h2>
            <p class="text-sm md:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto">
              Dikenal sebagai Dokter Namira oleh para pasiennya, Dr. Namira Farhayati Lubis aktif memberikan pelayanan kesehatan medis primer untuk warga Malang dan sekitarnya. Dengan pendekatan holistik yang memadukan keahlian kedokteran medis modern, kenyamanan pasien, dan komunikasi empatik.
            </p>
          </div>

          <!-- Modern Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <div class="group relative bg-white p-6 md:p-8 rounded-2xl border border-slate-200 hover:border-teal-300 hover:shadow-premium transition-all duration-300 overflow-hidden">
              <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-br from-teal-50 to-teal-100/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-110"></div>
              <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center mb-5 group-hover:bg-teal-600 group-hover:text-white transition-colors duration-300">
                <ShieldCheck size={24} />
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-teal-deep transition-colors">Izin Praktek Resmi</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Terdaftar dan sah melayani pasien di wilayah hukum Kota Malang.
              </p>
              <div class="mt-4 pt-4 border-t border-slate-100">
                <span class="inline-block bg-slate-100 text-slate-700 text-xs font-mono font-medium px-3 py-1.5 rounded-lg">SIP: 100.3.12/201.0401</span>
              </div>
            </div>

            <div class="group relative bg-white p-6 md:p-8 rounded-2xl border border-slate-200 hover:border-emerald-300 hover:shadow-premium transition-all duration-300 overflow-hidden">
              <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-br from-emerald-50 to-emerald-100/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-110"></div>
              <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
                <Heart size={24} />
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-emerald-700 transition-colors">Fokus Layanan Medis</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Pemeriksaan umum, dokter homevisit ke rumah, terapi bekam medis higienis, dan konsultasi privasi IMS.
              </p>
              <ul class="mt-4 pt-4 border-t border-slate-100 space-y-2">
                <li class="flex items-center space-x-2 text-xs text-slate-500">
                  <CheckCircle2 size={14} class="text-emerald-500" /> <span>Pemeriksaan Komprehensif</span>
                </li>
                <li class="flex items-center space-x-2 text-xs text-slate-500">
                  <CheckCircle2 size={14} class="text-emerald-500" /> <span>Layanan 100% Privat</span>
                </li>
              </ul>
            </div>

          </div>

          <!-- Bottom CTA -->
          <div class="text-center mt-12 scroll-animate">
            <a
              href="https://wa.me/6285819800843?text=Halo%20Dokter%20Namira%2C%20saya%20ingin%20berkonsultasi%20langsung..."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-bold px-8 py-4 rounded-full shadow-premium hover:-translate-y-1 transition-all duration-300 w-full sm:w-auto text-sm"
            >
              <PhoneCall size={18} />
              <span>Konsultasi Langsung via WhatsApp</span>
            </a>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat client:idle />
</BaseLayout>
