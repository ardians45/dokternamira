---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/React/WhatsAppFloat';
import PricelistFilter from '../components/React/PricelistFilter';
import { Tag, PhoneCall, CheckCircle2, AlertCircle } from 'lucide-react';
---

<BaseLayout
  title="Informasi Biaya & Pricelist Layanan - Dokter Namira Malang"
  description="Transparansi informasi estimasi biaya konsultasi dokter umum, tarif homecare, bekam medis, dan treatment kecantikan syar'i di Malang."
>
  <Header />

  <main class="flex-grow bg-slate-50">
    <!-- Premium Hero Section -->
    <section class="relative bg-slate-950 text-white pt-20 pb-24 overflow-hidden border-b border-teal-900/50">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-teal-800/40 via-transparent to-transparent"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-600/20 rounded-full blur-[100px]"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center scroll-animate">
        <div class="inline-flex items-center space-x-2 bg-white/10 border border-white/20 backdrop-blur-md px-4 py-2 rounded-full text-teal-300 text-xs font-bold uppercase tracking-widest mb-6 shadow-glass">
          <Tag size={14} />
          <span>Transparansi Tarif</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold tracking-tight leading-[1.15] mb-6">
          Estimasi Biaya <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-300">Layanan Medis</span>
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-sans">
          Komitmen kami untuk memberikan kejujuran dan keterbukaan tarif medis sebelum Anda memutuskan melakukan perawatan atau tindakan.
        </p>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="py-16 md:py-24 relative -mt-8 z-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        
        <!-- Important Notice Card -->
        <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-200 shadow-premium scroll-animate">
          <h2 class="text-xl md:text-2xl font-display font-bold text-slate-900 mb-4">Panduan Biaya & Tarif</h2>
          <div class="space-y-6 text-sm text-slate-600 leading-relaxed">
            <p class="text-base">
              Estimasi biaya perawatan medis di Praktek Dokter Namira bervariasi bergantung pada jenis tindakan yang diberikan, obat-obatan yang diresepkan, serta jarak tempuh lokasi kunjungan untuk layanan <strong class="text-teal-deep">Homecare</strong>.
            </p>
            
            <div class="bg-gradient-to-r from-amber-50 to-amber-100/50 p-5 md:p-6 rounded-2xl border border-amber-200/60 flex flex-col sm:flex-row items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center shrink-0">
                <AlertCircle size={24} />
              </div>
              <div>
                <strong class="block font-bold text-slate-900 text-base mb-1">Penting: Rincian Tarif Pasti</strong>
                <p class="text-slate-700">
                  Untuk mendapatkan rincian tarif terbaru secara resmi, silakan menghubungi admin kami langsung via WhatsApp. Kami selalu mengonfirmasi total biaya tindakan kepada Anda sebelum obat atau terapi diberikan.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Pricelist Filter Component -->
        <div class="scroll-animate" style="transition-delay: 100ms;">
          <div class="text-center space-y-3 mb-10">
            <h2 class="text-3xl md:text-4xl font-display font-extrabold text-slate-900">Daftar Tarif Treatment</h2>
            <p class="text-slate-500 font-medium">Katalog Layanan Syar'i Beauty Care & Bekam Medis</p>
          </div>

          <div class="bg-white p-4 md:p-8 rounded-3xl border border-slate-200 shadow-sm">
            <PricelistFilter client:load />
          </div>
        </div>

        <!-- Sticky Bottom CTA -->
        <div class="text-center pt-8 pb-4 scroll-animate">
          <a
            href="https://wa.me/6285819800843?text=Halo%20Dokter%20Namira%2C%20saya%20ingin%20bertanya%20detail%20estimasi%20biaya%20layanan..."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center space-x-2 bg-slate-900 hover:bg-slate-800 text-white font-bold px-8 py-4 rounded-full shadow-premium hover:-translate-y-1 transition-all duration-300 w-full sm:w-auto text-sm"
          >
            <PhoneCall size={18} />
            <span>Tanya Detail Biaya via WhatsApp</span>
          </a>
        </div>

      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat client:idle defaultMessage="Halo Dokter Namira, saya ingin bertanya estimasi biaya layanan..." />
</BaseLayout>
