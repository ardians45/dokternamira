---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/React/WhatsAppFloat';
import TestimonialSlider from '../components/React/TestimonialSlider';
import {
  Stethoscope,
  Home,
  ShieldCheck,
  Droplet,
  Sparkles,
  HeartPulse,
  CheckCircle2,
  MapPin,
  Clock,
  ChevronRight,
  PhoneCall,
  UserCheck,
  Activity,
  Award,
  Microscope,
  Syringe,
  HeartHandshake,
  FileCheck2,
  Sparkle,
  ShieldAlert,
  Flame,
  BadgeCheck,
  CalendarCheck,
  Check,
  ArrowRight,
  Shield,
  Star
} from 'lucide-react';
---

<BaseLayout
  title="Praktik Dokter Umum & Homecare di Malang - Dr. Namira Farhayati Lubis"
  description="Layanan konsultasi dokter, homecare, dan perawatan kesehatan di Malang dengan pelayanan yang nyaman dan profesional."
>
  <Header />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-white pt-12 pb-16 md:pt-20 md:pb-24 border-b border-slate-100">
      <!-- Animated Ambient Blobs -->
      <div class="absolute top-1/4 -left-20 w-80 h-80 md:w-96 md:h-96 bg-teal-soft/20 rounded-full blur-3xl mix-blend-multiply pointer-events-none animate-blob-float"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 md:w-[450px] md:h-[450px] bg-teal-light rounded-full blur-3xl opacity-70 pointer-events-none animate-blob-float" style="animation-delay: 2s;"></div>
      <div class="absolute top-10 right-1/3 w-64 h-64 bg-accent-pink/15 rounded-full blur-3xl pointer-events-none animate-blob-float" style="animation-delay: 4s;"></div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center pt-10 pb-16">
        <div class="space-y-8 scroll-animate w-full">
          
          <div class="inline-flex flex-col sm:flex-row items-center justify-center gap-2 sm:space-x-2 bg-teal-50/80 backdrop-blur-sm border border-teal-200/80 px-5 py-2.5 rounded-full text-xs font-bold text-teal-deep tracking-widest uppercase shadow-sm mx-auto">
            <span>Dr. Namira Farhayati Lubis</span>
            <span class="hidden sm:block w-1.5 h-1.5 rounded-full bg-teal-400"></span>
            <span>SIP: 100.3.12/201.0401/35.73.406/2024</span>
          </div>
          
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-display font-extrabold text-slate-900 tracking-tight leading-[1.15] max-w-4xl mx-auto">
            Praktik Dokter Umum & <span class="text-teal-deep relative whitespace-nowrap"><span class="relative z-10">Homecare</span><svg class="absolute w-full h-3 sm:h-4 bottom-1 sm:bottom-2 left-0 -z-10 text-teal-200/60" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="4" stroke-linecap="round" fill="none"/></svg></span> di Malang
          </h1>
          
          <p class="text-slate-600 text-base sm:text-xl leading-relaxed max-w-2xl mx-auto font-sans">
            Layanan konsultasi medis profesional, kunjungan dokter ke rumah (homecare), dan perawatan kesehatan dasar dengan mengutamakan kenyamanan serta privasi Anda.
          </p>

          <!-- CTA -->
          <div class="pt-4 flex flex-col sm:flex-row justify-center gap-4">
            <a
              href="https://wa.me/6285270001948?text=Halo%20Dokter%20Namira%2C%20saya%20ingin%20konsultasi..."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              <PhoneCall size={18} />
              <span>Konsultasi via WhatsApp</span>
            </a>
            <a
              href="#layanan-utama"
              class="inline-flex items-center justify-center space-x-2 bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 px-8 py-3.5 rounded-full font-bold shadow-sm transition-all hover:shadow-md hover:-translate-y-0.5"
            >
              <span>Lihat Layanan Utama</span>
              <ChevronRight size={16} />
            </a>
          </div>
        </div>

        <!-- 3 Bento Boxes Below -->
        <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 mt-16 scroll-animate" style="transition-delay: 200ms;">
          
          <!-- Box 1 -->
          <div class="bg-white/80 backdrop-blur-md border border-white/60 shadow-glass rounded-3xl p-6 md:p-8 text-left hover:-translate-y-1 transition-transform duration-300 group">
             <div class="w-14 h-14 bg-teal-100 text-teal-deep rounded-2xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
               <Home size={28} />
             </div>
             <h3 class="font-bold text-xl text-slate-900 mb-2">Homecare Visit</h3>
             <p class="text-sm text-slate-600 leading-relaxed mb-4">Dokter datang ke rumah untuk pemeriksaan lansia & pasca rawat di area Malang.</p>
             <div class="flex flex-wrap gap-1.5 mt-auto">
                <span class="text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-500 px-2.5 py-1 rounded-md">Merjosari</span>
                <span class="text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-500 px-2.5 py-1 rounded-md">Dinoyo</span>
             </div>
          </div>
          
          <!-- Box 2 -->
          <div class="bg-white/80 backdrop-blur-md border border-white/60 shadow-glass rounded-3xl p-6 md:p-8 text-left hover:-translate-y-1 transition-transform duration-300 group">
             <div class="w-14 h-14 bg-slate-100 text-slate-700 rounded-2xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
               <ShieldAlert size={28} />
             </div>
             <h3 class="font-bold text-xl text-slate-900 mb-2">100% Privasi IMS</h3>
             <p class="text-sm text-slate-600 leading-relaxed">Konsultasi infeksi menular seksual dengan jaminan kerahasiaan identitas & rekam medis yang sangat ketat.</p>
          </div>
          
          <!-- Box 3 -->
          <div class="bg-white/80 backdrop-blur-md border border-white/60 shadow-glass rounded-3xl p-6 md:p-8 text-left hover:-translate-y-1 transition-transform duration-300 relative overflow-hidden group">
             <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-pink-200/40 rounded-full blur-2xl transition-all group-hover:bg-pink-300/40"></div>
             <div class="w-14 h-14 bg-pink-50 text-pink-500 rounded-2xl flex items-center justify-center mb-5 relative z-10 group-hover:scale-110 transition-transform">
               <Sparkle size={28} />
             </div>
             <h3 class="font-bold text-xl text-slate-900 mb-2 relative z-10">Syar'i Beauty Care</h3>
             <p class="text-sm text-slate-600 leading-relaxed relative z-10">Layanan estetika dasar khusus muslimah, dilakukan di ruang tertutup dan nyaman.</p>
          </div>
          
        </div>
      </div>
    </section>

    <!-- TRUST SECTION (Typographic Grid) -->
    <section class="border-b border-slate-200 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-slate-200 scroll-animate">
          
          <div class="py-8 md:px-6 lg:px-8 space-y-2">
            <div class="flex items-center space-x-2 text-teal-deep">
              <BadgeCheck size={20} />
              <h4 class="font-display font-extrabold text-sm uppercase tracking-wider">SIP Aktif</h4>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed font-sans mt-1">
              Praktik oleh dokter yang terdaftar resmi (SIP: 100.3.12/201.0401/35.73.406/2024).
            </p>
          </div>

          <div class="py-8 md:px-6 lg:px-8 space-y-2">
            <div class="flex items-center space-x-2 text-teal-deep">
              <ShieldCheck size={20} />
              <h4 class="font-display font-extrabold text-sm uppercase tracking-wider">Privasi Pasien</h4>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Kerahasiaan data dan rekam medis pasien dijaga sesuai standar etika kedokteran.
            </p>
          </div>

          <div class="py-8 md:px-6 lg:px-8 space-y-2">
            <div class="flex items-center space-x-2 text-teal-deep">
              <Syringe size={20} />
              <h4 class="font-display font-extrabold text-sm uppercase tracking-wider">Peralatan Higienis</h4>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Peralatan steril sekali pakai untuk menjamin standar kebersihan dan keamanan medis.
            </p>
          </div>

          <div class="py-8 md:px-6 lg:px-8 space-y-2">
            <div class="flex items-center space-x-2 text-teal-deep">
              <HeartHandshake size={20} />
              <h4 class="font-display font-extrabold text-sm uppercase tracking-wider">Homecare</h4>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Layanan kunjungan dokter langsung ke rumah Anda untuk pasien rawat jalan.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- H2: Layanan Kesehatan yang Kami Sediakan -->
    <section class="py-16 md:py-24 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          
          <!-- Left: Section Title (Sticky) -->
          <div class="lg:col-span-4 lg:sticky lg:top-24 self-start space-y-6 scroll-animate">
            <span class="text-xs font-black text-teal-deep uppercase tracking-widest border-l-2 border-teal-deep pl-3">Layanan Kami</span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-display tracking-tight leading-tight">
              Layanan Medis <br class="hidden lg:inline"/>Umum
            </h2>
            <p class="text-sm text-slate-600 font-sans leading-relaxed">
              Cakupan pemeriksaan umum, laboratorium sederhana, dan tindakan medis sesuai keluhan pasien secara personal dan menyeluruh.
            </p>
          </div>

          <!-- Right: Services Index -->
          <div class="lg:col-span-8 space-y-8 pt-8 lg:pt-0 scroll-animate" style="transition-delay: 200ms;">
            <div class="divide-y divide-slate-100 border-t border-b border-slate-100">
              
              <!-- Service Category 1 -->
              <div class="py-8 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                <div class="md:col-span-1">
                  <h3 class="font-display font-extrabold text-lg text-slate-900">Konsultasi & Pemeriksaan</h3>
                </div>
                <div class="md:col-span-2">
                  <ul class="space-y-3 text-sm text-slate-600 leading-relaxed font-sans">
                    <li>• Konsultasi umum & Pemeriksaan fisik</li>
                    <li>• Peresepan dan penggunaan obat medis</li>
                    <li>• Kontrol tekanan darah & diabetes</li>
                    <li>• Konsultasi ibu & anak, cek kehamilan dasar</li>
                    <li>• Surat keterangan sakit, sehat, & berobat</li>
                  </ul>
                </div>
              </div>

              <!-- Service Category 2 -->
              <div class="py-8 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                <div class="md:col-span-1">
                  <h3 class="font-display font-extrabold text-lg text-slate-900">Tindakan Medis & Lab</h3>
                </div>
                <div class="md:col-span-2">
                  <ul class="space-y-3 text-sm text-slate-600 leading-relaxed font-sans">
                    <li>• Tes gula darah, kolesterol, asam urat (Stik)</li>
                    <li>• Cek tensi (tekanan darah) akurat</li>
                    <li>• Terapi Nebulizer (uap pernapasan)</li>
                    <li>• Perawatan luka & Ganti balut steril</li>
                    <li>• Pemasangan Kateter & NGT</li>
                  </ul>
                </div>
              </div>

              <!-- Service Category 3 -->
              <div class="py-8 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                <div class="md:col-span-1">
                  <h3 class="font-display font-extrabold text-lg text-slate-900">Layanan Khusus</h3>
                </div>
                <div class="md:col-span-2">
                  <ul class="space-y-3 text-sm text-slate-600 leading-relaxed font-sans">
                    <li>• Kunjungan Dokter ke Rumah (Homecare)</li>
                    <li>• Bekam Sunnah & Terapi Fashdu</li>
                    <li>• Infus Booster & Suntik Vitamin</li>
                    <li>• Konsultasi Infeksi Menular Seksual (IMS)</li>
                    <li>• Perawatan Wajah (Syar'i Beauty Care)</li>
                  </ul>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- H2: Layanan Medis Utama -->
    <section id="layanan-utama" class="py-16 md:py-24 bg-slate-50 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-3xl mb-16 space-y-4 scroll-animate">
          <span class="text-xs font-black text-teal-deep uppercase tracking-widest border-l-2 border-teal-deep pl-3">Pilar Layanan</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 font-display tracking-tight leading-tight">
            Layanan Medis <span class="text-teal-deep">Utama</span>
          </h2>
          <p class="text-slate-600 text-sm md:text-base font-sans leading-relaxed max-w-xl">
            Layanan kesehatan spesifik unggulan dari Praktek Dokter Namira, dirancang dengan mengutamakan standar medis yang tepat, privasi, dan kenyamanan Anda.
          </p>
        </div>

        <div class="space-y-12 lg:space-y-24">
          
          <!-- Homecare (Text Left, Abstract UI Right) -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center scroll-animate">
            <div class="lg:col-span-5 space-y-6 lg:order-1">
              <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-900 flex items-center justify-center">
                <Home size={24} />
              </div>
              <h3 class="font-display font-extrabold text-2xl lg:text-3xl text-slate-900">Dokter Homecare & Homevisit</h3>
              <p class="text-sm text-slate-600 leading-relaxed font-sans">
                Layanan kunjungan dokter umum langsung ke rumah Anda. Solusi terbaik bagi pasien lansia, pasca operasi, atau mereka yang kesulitan bepergian ke fasilitas kesehatan.
              </p>
              <div class="text-xs text-slate-500 font-semibold uppercase tracking-wider space-y-1">
                <p>Area Layanan:</p>
                <p class="text-teal-deep">Merjosari • Dinoyo • Lowokwaru • Tlogomas • Dau • Blimbing • Sukun • Klojen</p>
              </div>
              <div>
                <a href="/layanan/homecare-malang" class="inline-flex items-center space-x-2 text-sm font-bold text-white bg-slate-900 hover:bg-slate-800 px-6 py-3 rounded-xl transition-colors shadow-premium hover:-translate-y-0.5">
                  <span>Pelajari Layanan Homecare</span>
                  <ChevronRight size={16} />
                </a>
              </div>
            </div>
            <div class="lg:col-span-7 lg:order-2 bg-gradient-to-br from-teal-50 to-teal-100/50 aspect-[4/3] rounded-3xl relative overflow-hidden flex items-center justify-center border border-white shadow-glass">
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-teal-200/40 via-transparent to-transparent"></div>
                
                <!-- Floating Icon Container -->
                <div class="relative z-10 w-32 h-32 md:w-48 md:h-48 bg-white/60 backdrop-blur-xl rounded-full flex items-center justify-center shadow-2xl border border-white/80 animate-blob-float">
                  <Home size={64} class="text-teal-deep/80" strokeWidth={1.5} />
                </div>
                
                <!-- Floating abstract badge -->
                <div class="absolute bottom-10 right-10 md:bottom-16 md:right-16 bg-white/80 backdrop-blur-md border border-white/60 px-5 py-2.5 rounded-full shadow-premium animate-blob-float delay-500 hidden md:block">
                  <span class="text-xs font-bold text-teal-deep tracking-wide">24/7 Available</span>
                </div>
            </div>
          </div>

          <!-- IMS (Abstract UI Left, Text Right) -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center scroll-animate">
            <div class="lg:col-span-7 bg-gradient-to-tr from-slate-100 to-slate-50 aspect-[4/3] rounded-3xl relative overflow-hidden flex items-center justify-center border border-white shadow-glass">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,_var(--tw-gradient-stops))] from-slate-200/80 via-transparent to-transparent"></div>
                
                <!-- Floating Icon Container -->
                <div class="relative z-10 w-32 h-32 md:w-48 md:h-48 bg-white/60 backdrop-blur-xl rounded-full flex items-center justify-center shadow-2xl border border-white/80 animate-blob-float delay-300">
                  <ShieldAlert size={64} class="text-slate-700/80" strokeWidth={1.5} />
                </div>
                
                <!-- Floating abstract badge -->
                <div class="absolute top-10 left-10 md:top-16 md:left-16 bg-white/80 backdrop-blur-md border border-white/60 px-5 py-2.5 rounded-full shadow-premium animate-blob-float delay-700 hidden md:block">
                  <span class="text-xs font-bold text-slate-700 tracking-wide">100% Confidential</span>
                </div>
            </div>
            <div class="lg:col-span-5 space-y-6">
              <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-900 flex items-center justify-center">
                <ShieldAlert size={24} />
              </div>
              <h3 class="font-display font-extrabold text-2xl lg:text-3xl text-slate-900">Konsultasi & Penanganan IMS</h3>
              <p class="text-sm text-slate-600 leading-relaxed font-sans">
                Layanan konsultasi terkait Infeksi Menular Seksual (IMS) yang 100% menjaga kerahasiaan identitas dan rekam medis Anda, dengan pendekatan komunikasi medis yang objektif tanpa penghakiman.
              </p>
              <div>
                <a href="/layanan/infeksi-menular-seksual" class="inline-flex items-center space-x-2 text-sm font-bold text-white bg-slate-900 hover:bg-slate-800 px-6 py-3 rounded-xl transition-colors shadow-premium hover:-translate-y-0.5">
                  <span>Pelajari Layanan IMS</span>
                  <ChevronRight size={16} />
                </a>
              </div>
            </div>
          </div>
          
          <!-- Infus & Bekam (Grid) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16 scroll-animate">
            
            <div class="border-t border-slate-200 pt-8 space-y-5">
              <div class="flex items-center space-x-4">
                <div class="w-10 h-10 rounded-lg bg-teal-100 text-teal-900 flex items-center justify-center">
                  <Droplet size={20} />
                </div>
                <h3 class="font-display font-extrabold text-xl text-slate-900">Infus Booster & Vitamin</h3>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed font-sans">
                Pemulihan stamina tubuh dan peningkatan daya tahan melalui asupan multivitamin intravena yang disesuaikan dengan kondisi medis Anda berdasarkan hasil konsultasi dokter.
              </p>
              <a href="/layanan/infus-booster-vitamin" class="inline-flex items-center space-x-2 text-sm font-bold text-teal-deep hover:text-teal-hover transition-colors">
                <span>Selengkapnya</span>
                <ArrowRight size={16} />
              </a>
            </div>

            <div class="border-t border-slate-200 pt-8 space-y-5">
              <div class="flex items-center space-x-4">
                <div class="w-10 h-10 rounded-lg bg-teal-100 text-teal-900 flex items-center justify-center">
                  <Flame size={20} />
                </div>
                <h3 class="font-display font-extrabold text-xl text-slate-900">Bekam Sunnah & Fashdu</h3>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed font-sans">
                Tindakan terapi bekam dan fashdu yang dilakukan dengan memastikan standar kebersihan tinggi. Kami menggunakan alat steril sekali pakai (single-use) demi menghindari risiko infeksi silang.
              </p>
              <a href="/layanan/bekam-sunnah-fashdu" class="inline-flex items-center space-x-2 text-sm font-bold text-teal-deep hover:text-teal-hover transition-colors">
                <span>Selengkapnya</span>
                <ArrowRight size={16} />
              </a>
            </div>

          </div>

          <!-- Syari Care (Full Width Premium Mesh Callout) -->
          <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-pink-50 to-pink-100/50 border border-white shadow-glass p-10 lg:p-16 scroll-animate">
             <!-- Mesh Gradient Blurs -->
             <div class="absolute -top-24 -right-24 w-64 h-64 bg-pink-300/30 rounded-full blur-3xl"></div>
             <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-teal-200/20 rounded-full blur-3xl"></div>
             
             <div class="relative z-10 max-w-3xl space-y-6">
                <span class="inline-block px-4 py-1.5 rounded-full bg-white/80 backdrop-blur-sm border border-pink-100 text-xs font-bold text-pink-600 uppercase tracking-widest shadow-sm">
                  Khusus Muslimah/Wanita
                </span>
                <h3 class="font-display font-extrabold text-3xl lg:text-4xl text-slate-900 leading-tight">Syar'i Beauty Care</h3>
                <p class="text-base text-slate-700 leading-relaxed font-sans max-w-2xl">
                  Layanan estetika medis dasar seperti Facial dan Peeling yang dirancang khusus untuk kenyamanan dan privasi wanita. Dilakukan di ruang tertutup khusus oleh tenaga medis wanita profesional.
                </p>
                <div class="pt-2">
                  <a href="/layanan/syari-beauty-care" class="inline-flex items-center space-x-2 text-sm font-bold text-white bg-pink-600 hover:bg-pink-700 px-8 py-4 rounded-xl transition-all duration-300 shadow-premium hover:-translate-y-0.5">
                    <span>Pelajari Perawatan Khusus</span>
                    <ChevronRight size={16} />
                  </a>
                </div>
             </div>
          </div>

        </div>

      </div>
    </section>

    <!-- H2: Filosofi & Komitmen -->
    <section class="py-16 md:py-24 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <div class="lg:col-span-5 scroll-animate">
            <div class="relative w-full aspect-[4/3] lg:aspect-[3/4] bg-gradient-to-br from-teal-deep to-teal-700 rounded-2xl p-8 md:p-12 flex flex-col justify-center overflow-hidden shadow-2xl">
              <!-- Decorative abstract shapes -->
              <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
